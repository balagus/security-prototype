<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DotnetApi</RootNamespace>
    <AssemblyName>DotnetApi</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Requires Microsoft.EntityFrameworkCore(.Relational) >= 10.0.4 transitively -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.KeyPerFile" Version="10.0.15" />
  </ItemGroup>

  <!-- Phase 5: OpenTelemetry (all Apache-2.0; Npgsql.OpenTelemetry: PostgreSQL License). Only
       active when OTEL_EXPORTER_OTLP_ENDPOINT is set (Program.cs); phases 0 to 4 send nothing.
       Npgsql.OpenTelemetry matches the Npgsql version EF Core pulls in (10.0.3). -->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageReference Include="Npgsql.OpenTelemetry" Version="10.0.3" />
  </ItemGroup>

</Project>

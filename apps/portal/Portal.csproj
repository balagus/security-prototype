<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Access approval portal (docs/DECISIONS.md D11). All packages MIT
       (Microsoft.Data.Sqlite bundles SQLite, public domain). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Portal</RootNamespace>
    <AssemblyName>Portal</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The Angular UI lives in ui/ and is built in its own Docker stage. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);ui/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
  </ItemGroup>

</Project>

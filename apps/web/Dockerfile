FROM node:24-alpine AS build
WORKDIR /app
ENV NG_CLI_ANALYTICS=false
COPY package.json ./
RUN npm install --no-audit --no-fund
COPY . .
# Browser telemetry (Grafana Faro) is off unless FARO_ENABLED=true (compose.yaml).
# The API key is not a secret (it ships in the bundle); only [A-Za-z0-9._-] is accepted.
ARG FARO_ENABLED=false
ARG FARO_API_KEY=
RUN set -e; \
    case "$FARO_ENABLED" in true|false) ;; *) echo "FARO_ENABLED must be true or false" >&2; exit 1;; esac; \
    case "$FARO_API_KEY" in *[!A-Za-z0-9._-]*) echo "FARO_API_KEY: only [A-Za-z0-9._-]" >&2; exit 1;; esac; \
    printf "// Generated by the Dockerfile from the build args.\nexport const FARO_ENABLED = %s;\nexport const FARO_API_KEY = '%s';\n" "$FARO_ENABLED" "$FARO_API_KEY" > src/telemetry-config.ts
RUN npx ng build --configuration production

FROM nginx:stable-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/web/browser /usr/share/nginx/html
EXPOSE 80
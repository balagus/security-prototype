// Grafana Alloy (Apache-2.0), the single entry point for debug telemetry.
// Adapted from balagus/telemetries config/alloy/config.alloy at commit 91f6f8d.
// Changes from the source:
//   - No Mimir / metrics pipeline (lab memory budget: no metrics backend).
//   - A redaction stage runs before anything is stored: e-mail addresses are masked, query
//     strings, request bodies and SQL parameter values are deleted (otelcol.processor.transform).
//   - Faro: API key required, CORS limited to the app origin, logs masked
//     (loki.process) before loki.write.
//   - Listeners are reachable only on the internal networks "telemetry" (apps, web) and
//     "telemetry-store" (Loki, Tempo). No published port.
//
// Telemetry is NOT the audit trail. The audit pipeline (fluent-bit, log-store) is separate,
// has no network, and nothing here reads or writes it.

// ---------------------------------------------------------------------------
// Ingest: OTLP from the APIs
// ---------------------------------------------------------------------------
otelcol.receiver.otlp "default" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		logs   = [otelcol.processor.memory_limiter.default.input]
		traces = [otelcol.processor.memory_limiter.default.input]
	}
}

otelcol.processor.memory_limiter "default" {
	check_interval = "1s"
	limit          = "120MiB" // container mem_limit is 192m

	output {
		logs   = [otelcol.processor.transform.redact.input]
		traces = [otelcol.processor.transform.redact.input]
	}
}

// ---------------------------------------------------------------------------
// Redaction: nothing below this point may contain PII.
// ---------------------------------------------------------------------------
otelcol.processor.transform "redact" {
	error_mode = "ignore"

	trace_statements {
		context    = "span"
		statements = [
			`delete_matching_keys(attributes, "^db\\.query\\.parameter\\..*")`,
			`delete_matching_keys(attributes, "^http\\.request\\.body.*")`,
			`delete_matching_keys(attributes, "^http\\.response\\.body.*")`,
			`delete_key(attributes, "url.query")`,
			`replace_pattern(attributes["url.full"], "\\?.*$", "")`,
			`replace_pattern(attributes["http.url"], "\\?.*$", "")`,
			`replace_pattern(attributes["http.target"], "\\?.*$", "")`,
			`replace_all_patterns(attributes, "value", "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}", "<email>")`,
			`replace_pattern(name, "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}", "<email>")`,
		]
	}

	trace_statements {
		context    = "spanevent"
		statements = [
			`replace_all_patterns(attributes, "value", "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}", "<email>")`,
		]
	}

	log_statements {
		context    = "log"
		statements = [
			`replace_pattern(body, "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}", "<email>")`,
			`replace_all_patterns(attributes, "value", "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}", "<email>")`,
			`delete_key(attributes, "url.query")`,
		]
	}

	output {
		logs   = [otelcol.processor.batch.default.input]
		traces = [otelcol.processor.batch.default.input]
	}
}

otelcol.processor.batch "default" {
	send_batch_size = 2048
	timeout         = "2s"

	output {
		logs   = [otelcol.exporter.otlphttp.loki.input]
		traces = [otelcol.exporter.otlp.tempo.input]
	}
}

// ---------------------------------------------------------------------------
// Exporters (network telemetry-store only)
// ---------------------------------------------------------------------------
otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "tempo:4317"

		tls {
			insecure = true // lab: plain gRPC inside the internal telemetry-store network
		}
	}
}

otelcol.exporter.otlphttp "loki" {
	client {
		endpoint = "http://loki:3100/otlp"
	}
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}

// ---------------------------------------------------------------------------
// Ingest: Faro from the browser, same origin through nginx (/faro/ -> alloy:12347)
// ---------------------------------------------------------------------------
// The Faro API key is NOT a secret (it ships in the browser bundle). It only makes Alloy drop
// payloads that do not come from this app. compose.yaml passes the same value to the
// web build and to this container (FARO_API_KEY).
faro.receiver "frontend" {
	server {
		listen_address           = "0.0.0.0"
		listen_port              = 12347
		cors_allowed_origins     = ["http://localhost:8080"]
		api_key                  = sys.env("FARO_API_KEY")
		max_allowed_payload_size = "1MiB"

		rate_limiting {
			rate       = 50
			burst_size = 100
		}
	}

	output {
		logs   = [loki.process.faro_redact.receiver]
		traces = [otelcol.processor.transform.redact.input]
	}
}

// Faro log lines are logfmt text: mask e-mail addresses and drop query strings from URLs.
loki.process "faro_redact" {
	forward_to = [loki.write.default.receiver]

	stage.replace {
		expression = "([A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,})"
		replace    = "<email>"
	}

	stage.replace {
		expression = "https?://[^\\s\"?]+(\\?[^\\s\"]*)"
		replace    = ""
	}

	stage.static_labels {
		values = {
			service_name = "web",
		}
	}
}
